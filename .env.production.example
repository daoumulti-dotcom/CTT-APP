NODE_ENV=production
PORT=5000
DATABASE_URL=file:/app/data/ctt.db
TRUST_PROXY_HOPS=1

# Keep the existing JWT_SECRET when importing the current CTT database.
# Set this on the server only. Never commit or send the real value in chat.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_48_CHARACTERS

# Used only when initializing a new database or recovering an unconfigured director account.
INITIAL_DG_CODE=REPLACE_WITH_A_PRIVATE_RANDOM_DIRECTOR_CODE
