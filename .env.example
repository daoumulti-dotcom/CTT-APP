# Configuration locale de production — à personnaliser avant le démarrage
PORT=5000
DATABASE_URL="file:./dev.db"
# Remplacez par une clé secrète aléatoire unique d'au moins 48 caractères.
JWT_SECRET=REMPLACER_PAR_UNE_CLE_ALEATOIRE_UNIQUE_DE_64_CARACTERES
# Remplacez par un code directeur initial confidentiel d'au moins 16 caractères.
INITIAL_DG_CODE=REMPLACER_PAR_UN_CODE_DIRECTEUR_CONFIDENTIEL
# N'activer que derrière un proxy de confiance qui est le seul chemin vers le port 5000.
TRUST_PROXY_HOPS=0
